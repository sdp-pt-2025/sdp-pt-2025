# Campus Study Buddy - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=8080
HOST=localhost

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Firebase Project ID (from Firebase Console)
FIREBASE_PROJECT_ID=sd2025law

# Path to Firebase service account key file
GOOGLE_APPLICATION_CREDENTIALS=./backend/service-account.json

# Firebase Web App Configuration (for frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=sd2025law.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sd2025law
VITE_FIREBASE_STORAGE_BUCKET=sd2025law.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# =============================================================================
# EXTERNAL API CONFIGURATION
# =============================================================================
# OpenWeatherMap API Key (get from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_CACHE_DURATION=300000

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760
# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=application/pdf

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Rate limiting window in milliseconds (15 minutes default)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Firebase Cloud Messaging Server Key
FCM_SERVER_KEY=your_fcm_server_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Firestore emulator settings (for local development)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_EMULATOR_PORT=8080

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (error, warn, info, debug)
LOG_LEVEL=debug
# Enable request logging
ENABLE_REQUEST_LOGGING=true
# Enable database query logging
ENABLE_DB_LOGGING=true

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test database configuration
TEST_DATABASE_URL=your_test_database_url_here
# Test Firebase project ID
TEST_FIREBASE_PROJECT_ID=sd2025law-test
# Test API key for external services
TEST_OPENWEATHER_API_KEY=your_test_api_key_here

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT secret for development (use strong secret in production)
JWT_SECRET=your_jwt_secret_here
# Session secret
SESSION_SECRET=your_session_secret_here
# Encryption key for sensitive data
ENCRYPTION_KEY=your_encryption_key_here

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Enable hot reload
HOT_RELOAD=true
# Enable source maps
ENABLE_SOURCE_MAPS=true
# Enable debug mode
DEBUG_MODE=true
# Enable API documentation
ENABLE_API_DOCS=true

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=true
# Enable error tracking
ENABLE_ERROR_TRACKING=true
# Analytics tracking ID
ANALYTICS_TRACKING_ID=your_analytics_id_here

# =============================================================================
# EMAIL CONFIGURATION (for notifications)
# =============================================================================
# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@campusstudybuddy.com

# =============================================================================
# REDIS CONFIGURATION (for caching and sessions)
# =============================================================================
# Redis connection string (optional, for production)
REDIS_URL=redis://localhost:6379
# Enable Redis caching
ENABLE_REDIS_CACHE=false

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup storage configuration
BACKUP_STORAGE_TYPE=local
BACKUP_STORAGE_PATH=./backups
# Enable automatic backups
ENABLE_AUTO_BACKUP=false
# Backup frequency (daily, weekly, monthly)
BACKUP_FREQUENCY=daily
