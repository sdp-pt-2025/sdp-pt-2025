// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  uid         String    @unique // Firebase UID
  email       String    @unique
  displayName String
  photoURL    String?
  university  String
  studentId   String
  yearOfStudy Int
  faculty     String
  modules     String[]
  fcmToken    String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Study preferences (embedded as JSON)
  studyPreferences Json? // Will store the nested object
  availability     Json? // Will store the weekly availability
  joinRequests     GroupJoinRequest[] @relation("UserJoinRequests")
  adminResponses   GroupJoinRequest[] @relation("AdminResponses")

  // Relationships
  createdGroups       StudyGroup[]              @relation("GroupCreator")
  groupMemberships    GroupMember[]
  studySessions       StudySession[]
  progressRecords     ProgressTracking[]
  sentMessages        GroupMessage[]
  notifications       Notification[]
  uploadedFiles       CourseworkFile[]
  reportedBugs        Bug[]
  sessionParticipants StudySessionParticipant[]

  // Friend relationships
  sentFriendRequests     Friendship[] @relation("FriendRequester")
  receivedFriendRequests Friendship[] @relation("FriendReceiver")

  // Chat relationships
  chatsAsParticipant1 Chat[]        @relation("ChatParticipant1")
  chatsAsParticipant2 Chat[]        @relation("ChatParticipant2")
  sentChatMessages    ChatMessage[]

  @@map("users")
}

model Friendship {
  id          String    @id @default(cuid())
  requesterId String // User who sent the friend request
  receiverId  String // User who received the friend request
  status      String    @default("pending") // pending, accepted, declined
  message     String? // Optional message with friend request
  requestedAt DateTime  @default(now())
  respondedAt DateTime?
  acceptedAt  DateTime? // When the request was accepted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  requester User @relation("FriendRequester", fields: [requesterId], references: [uid], onDelete: Cascade)
  receiver  User @relation("FriendReceiver", fields: [receiverId], references: [uid], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("friendships")
}

// Chat models
model Chat {
  id             String    @id @default(cuid())
  participant1Id String
  participant2Id String
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relationships
  participant1 User          @relation("ChatParticipant1", fields: [participant1Id], references: [uid], onDelete: Cascade)
  participant2 User          @relation("ChatParticipant2", fields: [participant2Id], references: [uid], onDelete: Cascade)
  messages     ChatMessage[]

  @@unique([participant1Id, participant2Id])
  @@map("chats")
}

model ChatMessage {
  id          String    @id @default(cuid())
  chatId      String
  senderId    String
  content     String
  messageType String    @default("text") // text, image, file, audio, video
  attachments Json? // Array of attachment objects
  replyToId   String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  edited      Boolean   @default(false)
  editedAt    DateTime?
  reactions   Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chat    Chat          @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender  User          @relation(fields: [senderId], references: [uid], onDelete: Cascade)
  replyTo ChatMessage?  @relation("MessageReply", fields: [replyToId], references: [id])
  replies ChatMessage[] @relation("MessageReply")

  @@map("chat_messages")
}

model StudyGroup {
  id             String   @id @default(cuid())
  name           String
  description    String?
  module         String
  topic          String
  createdBy      String
  createdByName  String
  memberCount    Int      @default(0)
  maxMembers     Int      @default(10)
  isPublic       Boolean  @default(true)
  tags           String[]
  status         String   @default("active")
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location Json?
  schedule Json?

  joinRequests GroupJoinRequest[]
  creator      User               @relation("GroupCreator", fields: [createdBy], references: [uid])
  members      GroupMember[]
  messages     GroupMessage[]

  @@map("study_groups")
}

model GroupMember {
  id      String @id @default(cuid())
  userId  String
  groupId String

  user  User       @relation(fields: [userId], references: [uid], onDelete: Cascade)
  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_members")
}

// Group chat messages
model GroupMessage {
  id          String    @id @default(cuid())
  groupId     String
  senderId    String
  senderName  String
  message     String
  messageType String    @default("text")
  attachments Json? // Changed from String[] to Json
  replyTo     String?
  edited      Boolean   @default(false)
  editedAt    DateTime?
  reactions   Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group  StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [uid], onDelete: Cascade)

  @@map("group_messages")
}

// Study sessions
model StudySession {
  id          String   @id @default(cuid())
  userId      String
  groupId     String?
  module      String
  topic       String
  sessionType String
  duration    Int
  startTime   DateTime
  endTime     DateTime
  completed   Boolean  @default(false)
  rating      Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location   Json?
  activities Json?

  // Relationships
  user         User                      @relation(fields: [userId], references: [uid], onDelete: Cascade)
  participants StudySessionParticipant[]

  @@map("study_sessions")
}

// Study session participants (for group sessions)
model StudySessionParticipant {
  id        String @id @default(cuid())
  sessionId String
  userId    String

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("study_session_participants")
}

// Progress tracking
model ProgressTracking {
  id                   String    @id @default(cuid())
  userId               String
  module               String
  topic                String
  status               String
  completionPercentage Int       @default(0)
  studyHours           Float     @default(0)
  lastStudied          DateTime?
  difficulty           Int? // 1-5 scale
  confidence           Int? // 1-5 scale
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  resources  Json?
  milestones Json?

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@unique([userId, module, topic])
  @@map("progress_tracking")
}

// Notifications
model Notification {
  id           String    @id @default(cuid())
  userId       String
  senderId     String
  senderName   String
  title        String
  body         String
  type         String // session_reminder, group_invite, friend_request, friend_request_response, etc.
  data         Json?
  read         Boolean   @default(false)
  readAt       DateTime?
  sentAt       DateTime  @default(now())
  fcmMessageId String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@map("notifications")
}

// Coursework files
model CourseworkFile {
  id               String    @id @default(cuid())
  fileName         String
  storagePath      String
  downloadUrl      String
  uploadedBy       String
  fileSize         Int
  mimeType         String
  isPublic         Boolean   @default(false)
  tags             String[]
  description      String?
  courseCode       String
  topic            String
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?
  uploadedAt       DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  uploader User @relation(fields: [uploadedBy], references: [uid], onDelete: Cascade)

  @@map("coursework_files")
}

model GroupJoinRequest {
  id          String    @id @default(cuid())
  userId      String
  groupId     String
  status      String    @default("pending") // pending, approved, rejected
  requestedAt DateTime  @default(now())
  respondedAt DateTime?
  respondedBy String?
  message     String?

  user      User       @relation("UserJoinRequests", fields: [userId], references: [uid], onDelete: Cascade)
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  responder User?      @relation("AdminResponses", fields: [respondedBy], references: [uid])

  @@unique([userId, groupId])
  @@map("group_join_requests")
}

// Bug reports
model Bug {
  id               String    @id @default(cuid())
  title            String
  description      String
  severity         String
  category         String
  status           String    @default("open")
  priority         Int       @default(3)
  reporterId       String
  reporterName     String
  reporterEmail    String
  assignedTo       String?
  assignedToName   String?
  stepsToReproduce String?
  expectedBehavior String?
  actualBehavior   String?
  attachments      String[] // Array of attachment URLs
  tags             String[]
  votes            Int       @default(0)
  voters           String[]
  watchers         String[]
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Environment and comments as JSON
  environment Json? // browser, os, device, version info
  comments    Json? // Array of comment objects

  reporter User @relation(fields: [reporterId], references: [uid], onDelete: Cascade)

  @@map("bugs")
}
