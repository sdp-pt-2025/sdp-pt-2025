{
    "version": 2,
    "builds": [
      {
        "src": "routes/**/*.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/routes/chats/(.*)",
        
        "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
        "headers": {
          "Access-Control-Allow-Origin": "https://campus-study.vercel.app",
          "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
          "Access-Control-Allow-Headers": "X-Requested-With, Content-Type, Accept, Authorization",
          "Access-Control-Allow-Credentials": "true"
        }
      },
      {
        "src": "/routes/users/(.*)",
       
        "headers": {
          "Access-Control-Allow-Origin": "https://campus-study.vercel.app",
          "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
          "Access-Control-Allow-Headers": "X-Requested-With, Content-Type, Accept, Authorization",
          "Access-Control-Allow-Credentials": "true"
        }
      },
      {
        "src": "/routes/dashboard/(.*)",
        
        "headers": {
          "Access-Control-Allow-Origin": "https://campus-study.vercel.app",
          "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
          "Access-Control-Allow-Headers": "X-Requested-With, Content-Type, Accept, Authorization",
          "Access-Control-Allow-Credentials": "true"
        }
      },
      {
        "src": "/routes/find-friends/(.*)",
        
        "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
        "headers": {
          "Access-Control-Allow-Origin": "https://campus-study.vercel.app",
          "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
          "Access-Control-Allow-Headers": "X-Requested-With, Content-Type, Accept, Authorization",
          "Access-Control-Allow-Credentials": "true"
        }
      },
      
      {
        "src": "/routes/profile/(.*)",
        
        "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
        "headers": {
          "Access-Control-Allow-Origin": "https://campus-study.vercel.app",
          "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
          "Access-Control-Allow-Headers": "X-Requested-With, Content-Type, Accept, Authorization",
          "Access-Control-Allow-Credentials": "true"
        }
      },
      
      {
        "src": "/routes/study-groups/(.*)",
        
        "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
        "headers": {
          "Access-Control-Allow-Origin": "https://campus-study.vercel.app",
          "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
          "Access-Control-Allow-Headers": "X-Requested-With, Content-Type, Accept, Authorization",
          "Access-Control-Allow-Credentials": "true"
        }
      },
      {
        "src": "/(.*)",
        "dest": "/app.js"
      }
    ]
  }