        "eslint": "^9.32.0",
        "eslint-plugin-jsonc": "^2.20.1",
        "globals": "^16.3.0",
        "jest": "^30.0.5",
        "jsonc-eslint-parser": "^2.4.0",
        "nodemon": "^3.1.10",
        "prisma": "^6.15.0",
        "supertest": "^7.1.4"
    },
    "dependencies": {
        "@prisma/client": "^6.15.0",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "firebase-admin": "^13.5.0",
        "uuid": "^13.0.0"
    },
    "prisma": {
